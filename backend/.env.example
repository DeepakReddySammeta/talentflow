# Local Postgres (matches docker-compose.yml at the repo root)
DATABASE_URL="postgresql://ats_user:ats_password@localhost:5432/ats_db?schema=public"

# Used to sign/verify JWTs — replace with any long random string
JWT_SECRET="replace-this-with-a-long-random-string"
JWT_EXPIRES_IN="2h"

# Free-tier Groq API key — get one at https://console.groq.com/keys
# Free tier: 14,400 requests/day, 30 RPM
GROQ_API_KEY="your-groq-api-key-here"
GROQ_MODEL="openai/gpt-oss-120b"

PORT=4000
CORS_ORIGIN="http://localhost:3000"
